{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)"
  ],
  "automerge": true,
  "major": {
    "automerge": false
  },
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "ignoreDeps": [
    "dev.flutter.flutter-plugin-loader",
  ]
}
