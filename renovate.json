{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)"
  ],
  "labels": [
    "renovate-bot"
  ],
  "schedule": [
    "after 10pm and before 5am every weekend",
    "every weekend"
  ],
  "automerge": true,
  "major": {
    "automerge": false
  },
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "ignoreDeps": [
    "dev.flutter.flutter-plugin-loader"
  ],
  "packageRules": [
    {
      "managers": [
        "pub"
      ],
      "matchPackagePatterns": [
        ".*"
      ],
      "postUpgradeTasks": {
        "commands": [
          "melos bs",
          "melos gen",
          "melos gen-l10n"
        ],
        "fileFilters": [
          "pubspec.lock",
          "packages/*/pubspec.lock",
          "**/*.g.dart",
          "**/*.freezed.dart"
        ]
      }
    },
    {
      "groupName": "Firebase",
      "matchPackagePatterns": [
        "^firebase"
      ]
    },
    {
      "groupName": "Freezed",
      "matchPackagePatterns": [
        "^freezed"
      ]
    }
  ]
}
